{
  "manifest_version": 3,
  "name": "DeepDesk Browser Connector",
  "version": "0.1.0",
  "description": "Connects DeepDesk to the current Edge or Chrome profile so browser tasks can use existing signed-in sessions.",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DeepDesk 浏览器连接器",
    "default_popup": "popup.html"
  }
}
